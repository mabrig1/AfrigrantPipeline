# AfrigrantPipeline — Railway (Express API) environment variables
# Set these in the Railway dashboard. NEVER commit real values.

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/afrigrant?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-min-64-chars

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://afrigrantpipeline.com

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key

# ── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your-key
RESEND_FROM_EMAIL=noreply@afrigrantpipeline.com

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
