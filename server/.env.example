# AfrigrantPipeline — Railway (Express API) environment variables
# Set these in the Railway dashboard. NEVER commit real values.

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://afrigrantpipeline.com

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@afrigrantpipeline.com

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
