# ═══════════════════════════════════════════════════════════════════════════════
# AfrigrantPipeline — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ═══════════════════════════════════════════════════════════════════════════════

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/afrigrant?retryWrites=true&w=majority

# ── NextAuth v5 ──────────────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
# next-auth v5 reads AUTH_SECRET; NEXTAUTH_SECRET works as a fallback alias
AUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=https://afrigrantpipeline.com

# ── Railway API (Express backend) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.afrigrantpipeline.com
NEXT_PUBLIC_APP_URL=https://afrigrantpipeline.com

# ── Cloudinary ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ — safe to expose in browser (cloud name only, used by next-cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Server-side only (used by src/lib/cloudinary.ts for signed uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key

# ── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY=re_your-key
RESEND_FROM_EMAIL=noreply@afrigrantpipeline.com

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ═══════════════════════════════════════════════════════════════════════════════
# Railway backend — set in the Railway dashboard, NOT in this file
# ═══════════════════════════════════════════════════════════════════════════════
# MONGODB_URI=         (same Atlas URI)
# JWT_SECRET=          openssl rand -base64 64
# OPENAI_API_KEY=      (same key)
# RESEND_API_KEY=      (same key)
# RESEND_FROM_EMAIL=   noreply@afrigrantpipeline.com
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# FRONTEND_URL=        https://afrigrantpipeline.com
# PORT=                8080
# NODE_ENV=            production
