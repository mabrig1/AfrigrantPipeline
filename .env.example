NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
DATABASE_URL=your_mongodb_connection_string
AUTH_SECRET=your_nextauth_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Existing AI proposal writer
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-opus-4-8

# Agentic Grant Intelligence
# OpenRouter is preferred for the grant-updating agent; Anthropic is used as fallback.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/auto

# Optional: broadens discovery beyond the curated official funder pages.
TAVILY_API_KEY=your_tavily_api_key

# Vercel Cron authentication. Generate a long random secret and add the same value in Vercel.
CRON_SECRET=your_long_random_cron_secret

# Optional comma-separated extra funding-source URLs.
AGENTIC_GRANT_SOURCES=

# Admin setup
# Authorized owner accounts can bootstrap without a setup secret.
# Add any additional owner/admin email addresses as a comma-separated list.
ADMIN_EMAILS=owner@example.com
# Optional fallback for bootstrapping a non-owner account.
ADMIN_SETUP_SECRET=your_secure_admin_setup_secret_here

# Consultancy: included creator access, project quotes and manual payment records.
# The existing DATABASE_URL/AUTH_SECRET/Google configuration is reused.
# Sign in with Google as mabrig1@gmail.com for verified creator access.
# First verified owner promotion removes any unverified password; existing admins keep their login.
# OPENROUTER_API_KEY (preferred) or ANTHROPIC_API_KEY powers case documents.
# TAVILY_API_KEY enables per-case live grant and research-partner searches.
# Without AI/search keys, case intake, quotes, manual documents and tracking work.

# Creator password recovery
# Recommended: configure a random 32+ character value in the production environment.
# If omitted, the recovery endpoint falls back to ADMIN_SETUP_SECRET.
OWNER_RECOVERY_SECRET=your_long_random_creator_recovery_secret_here
